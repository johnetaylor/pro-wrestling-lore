{
  "id": "nwa-national-heavyweight-championship",
  "name": "NWA National Heavyweight Championship",
  "promotion": "nwa",
  "division": "men",
  "format": "singles",
  "established": "1980-01-12",
  "names": [
    "NWA National Championship"
  ],
  "eras": [
    {
      "name": "NWA National Heavyweight Championship",
      "from": "1980-01-12",
      "to": "2018-10-21"
    },
    {
      "name": "NWA National Championship",
      "from": "2018-10-21",
      "to": "2022"
    },
    {
      "name": "NWA National Heavyweight Championship",
      "from": "2022"
    }
  ],
  "history": [
    {
      "date": "1984-07",
      "kind": "recognition",
      "text": "After GCW was bought by the WWF in July 1984, The Spoiler joined the WWF, which briefly recognized the title.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "1984-07",
      "kind": "promotion",
      "text": "Championship Wrestling from Georgia, founded by Ole Anderson, launched with NWA affiliation, and the title was awarded to Ted DiBiase.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "1985",
      "kind": "promotion",
      "text": "Jim Crockett Promotions bought Championship Wrestling from Georgia and began recognizing its championships.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "1986-09-28",
      "kind": "unified-into",
      "text": "Nikita Koloff beat Wahoo McDaniel in a unification match, and the National title was then deactivated.",
      "related": [
        "NWA United States Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "1986-09-28",
      "kind": "deactivated",
      "text": "The title was deactivated after being unified with the NWA United States Heavyweight Championship.",
      "related": [
        "NWA United States Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "1997-05",
      "kind": "reactivated",
      "text": "The title was reactivated and promoted by various NWA-affiliated independent promotions.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "2017-10",
      "kind": "promotion",
      "text": "Billy Corgan's Lightning One, Inc. bought the NWA's properties, ending affiliation agreements and leading to the title being vacated.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "2018-10-21",
      "kind": "reactivated",
      "text": "The title was renamed the NWA National Championship and reactivated, with an eight-man tournament at the NWA 70th Anniversary Show won by Willie Mack.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_National_Heavyweight_Championship"
      ]
    }
  ],
  "sources": [
    "https://www.wrestling-titles.com/nwa/others/nat-h.html",
    "https://en.wikipedia.org/wiki/NWA_National_Heavyweight_Championship"
  ],
