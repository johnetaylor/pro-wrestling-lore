{
  "id": "nwa-world-womens-championship",
  "name": "NWA World Women's Championship",
  "promotion": "nwa",
  "division": "women",
  "format": "singles",
  "established": "1950",
  "names": [
    "NWA Women's Championship"
  ],
  "eras": [
    {
      "name": "NWA Women's Championship",
      "from": "1950",
      "to": "2016-09-16"
    },
    {
      "name": "NWA World Women's Championship",
      "from": "2016-09-16"
    }
  ],
  "history": [
    {
      "date": "1954-08-20",
      "kind": "split",
      "text": "Burke's match with June Byers was stopped, Byers was awarded the title, and Burke created the WWWA World Championship.",
      "related": [
        "WWWA World Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Women%27s_Championship"
      ]
    },
    {
      "date": "1956-09-18",
      "kind": "recognition",
      "text": "Moolah won a disputed version in a battle royal, recognized only in the Northeast until Byers retired in 1964.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Women%27s_Championship"
      ]
    },
    {
      "date": "1964",
      "kind": "recognition",
      "text": "After June Byers retired, Moolah was universally recognized as NWA champion.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Women%27s_Championship"
      ]
    },
    {
      "date": "1983-12-31",
      "kind": "promotion",
      "text": "The WWF left the NWA, and Moolah sold the physical belt to the WWF, where it became the WWF Women's Championship.",
      "related": [
        "WWF Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Women%27s_Championship"
      ]
    },
    {
      "date": "1987",
      "kind": "deactivated",
      "text": "The title was declared vacant when the Kansas City promotion withdrew from the NWA.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Women%27s_Championship"
      ]
    },
    {
      "date": "1996-05-09",
      "kind": "recognition",
      "text": "Jim Crockett Promotions recognized Bambi as champion while Debbie Combs kept defending the title.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Women%27s_Championship"
      ]
    },
    {
      "date": "2016-09-16",
      "kind": "promotion",
      "text": "The title was renamed NWA World Women's Championship under the NWA/Lightning One Inc. banner, and the 1986–2002 design returned.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Women%27s_Championship"
      ]
    },
    {
      "date": "2019-04-22",
      "kind": "deactivated",
      "text": "Jazz vacated the title due to medical and personal reasons.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Women%27s_Championship"
      ]
    },
    {
      "date": "2019-09-30",
      "kind": "replaces",
      "text": "NWA President Billy Corgan presented a new belt that replaced the 2016–2019 design.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Women%27s_Championship"
      ]
    }
  ],
