{
  "id": "cmll-world-trios-championship",
  "name": "CMLL World Trios Championship",
  "promotion": "cmll",
  "division": "men",
  "format": "trios",
  "established": "1991-11-22",
  "names": [
    "CMLL World Trios Championship (Spanish: Campeonato Mundial de Trios)"
  ],
  "eras": [
    {
      "name": "CMLL World Trios Championship (Spanish: Campeonato Mundial de Trios)",
      "from": "1991"
    }
  ],
  "history": [
    {
      "date": "1993",
      "kind": "promotion",
      "text": "The reigning Mexican National Trios Champions left CMLL in 1993 and took that title with them, leaving the CMLL World Trios Championship as the division's only title until 2001.",
      "related": [
        "Mexican National Trios Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Trios_Championship"
      ]
    },
    {
      "date": "1997-03-21",
      "kind": "deactivated",
      "text": "Vacated after Héctor Garza left for AAA; a one-night, eight-team tournament crowned Rey Bucanero, Emilio Charles Jr. and El Satánico.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Trios_Championship"
      ]
    },
    {
      "date": "1998-10",
      "kind": "deactivated",
      "text": "Vacated after Mr. Niebla was injured; an eight-team tournament (December 4–12, 1998) followed and was won by Black Warrior, Blue Panther and Dr. Wagner Jr.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Trios_Championship"
      ]
    },
    {
      "date": "2002-02",
      "kind": "deactivated",
      "text": "Black Warrior's team vacated the title in February 2002; Blue Panther and Dr. Wagner Jr. later reigned with Fuerza Guerrera replacing Black Warrior.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Trios_Championship"
      ]
    },
    {
      "date": "2006",
      "kind": "deactivated",
      "text": "Vacated after about 20 months without a defense; Los Guerreros de Atlantida won the title on September 29, 2006.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Trios_Championship"
      ]
    },
    {
      "date": "2008-05",
      "kind": "deactivated",
      "text": "Vacated after Los Perros del Mal removed Héctor Garza; an eight-team tournament began May 30, with the finals on June 13, 2008.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Trios_Championship"
      ]
    },
    {
      "date": "2013-05",
      "kind": "deactivated",
      "text": "El Bufete del Amor vacated after Marco Corleone suffered a knee injury; an eight-team tournament (June 9–16, 2013) was won by Los Estetas del Aire.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Trios_Championship"
      ]
    },
    {
      "date": "2015",
      "kind": "reactivated",
      "text": "CMLL's Guadalajara branch revived the Occidente Trios Championship for shows in Jalisco, which the article considers tertiary to the world and national titles.",
      "related": [
        "Occidente Trios Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Trios_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/List_of_CMLL_World_Trios_Champions",
    "https://en.wikipedia.org/wiki/CMLL_World_Trios_Championship"
  ],
