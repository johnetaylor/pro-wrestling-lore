  "history": [
    {
      "date": "2009-03-19",
      "kind": "recognition",
      "text": "Declared an official TNA-sanctioned title after AJ Styles legally beat Booker T for it under their signed contract.",
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_Television_Championship"
      ]
    },
    {
      "date": "2014-07-03",
      "kind": "deactivated",
      "text": "Kurt Angle, as TNA Executive Director, declared the title inactive.",
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_Television_Championship"
      ]
    },
    {
      "date": "2015-06-25",
      "kind": "reactivated",
      "text": "Revived under the King of the Mountain Championship name, with a winner to be decided by a King of the Mountain match at Slammiversary.",
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_Television_Championship"
      ]
    },
    {
      "date": "2015-07-09",
      "kind": "promotion",
      "text": "Appeared in Global Force Wrestling when Eric Young attacked Jeff Jarrett and stole the belt at a live event.",
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_Television_Championship"
      ]
    },
    {
      "date": "2016-08-12",
      "kind": "unified-into",
      "text": "Bobby Lashley beat James Storm with his X Division and World Heavyweight titles on the line, unifying this title with his World Title and retiring it.",
      "related": [
        "X Division Championship",
        "World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_Television_Championship"
      ]
    },
    {
      "date": "2016-08-18",
      "kind": "retired",
      "text": "Announced at an Impact Wrestling taping that the title was vacated, deactivated and retired.",
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_Television_Championship"
      ]
    },
    {
      "date": "2016-08-18",
      "kind": "replaced-by",
      "text": "Announced alongside the retirement of this title as the new Impact Grand Championship.",
      "related": [
        "Impact Grand Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_Television_Championship"
      ]
    }
  ],
