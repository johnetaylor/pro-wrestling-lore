{
  "id": "aew-world-championship",
  "name": "AEW World Championship",
  "promotion": "aew",
  "division": "men",
  "format": "singles",
  "established": "2019-05-25",
  "names": [
    "Real World Championship (unofficial, not recognized by AEW; CM Punk's name for the belt he held)"
  ],
  "eras": [
    {
      "name": "AEW World Championship",
      "from": "2019-05-25",
      "to": "2023-07"
    },
    {
      "name": "Real World Championship (unofficial, not recognized by AEW; CM Punk's name for the belt he held)",
      "from": "2023-07"
    }
  ],
  "history": [
    {
      "date": "2021-04-25",
      "kind": "promotion",
      "text": "Kenny Omega defended the AEW title outside AEW, beating Impact World Champion Rich Swann in a Winner Takes All match at Impact's Rebellion.",
      "related": [
        "Impact World Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    },
    {
      "date": "2022-06-26",
      "kind": "interim",
      "text": "Jon Moxley beat Hiroshi Tanahashi at Forbidden Door to become interim champion while CM Punk was injured.",
      "related": [
        "Interim AEW World Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    },
    {
      "date": "2022-08-24",
      "kind": "unified-into",
      "text": "Moxley beat Punk on Dynamite to unify the interim and undisputed titles.",
      "related": [
        "Interim AEW World Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    },
    {
      "date": "2022-09-07",
      "kind": "deactivated",
      "text": "The title was vacated after Punk's backstage altercation with The Elite, and a tournament was announced to crown a new champion.",
      "related": [
        "AEW World Trios Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    },
    {
      "date": "2022-09-21",
      "kind": "reactivated",
      "text": "Moxley beat Bryan Danielson in the Grand Slam tournament final to win the vacant title for a record third time.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    },
    {
      "date": "2023-07",
      "kind": "recognition",
      "text": "Punk unveiled the belt he had won at All Out 2022, claimed the \"real\" title, and defended it on AEW programming, though AEW did not officially recognize it.",
      "related": [
        "Real World Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    },
    {
      "date": "2023-09-02",
      "kind": "deactivated",
      "text": "The Real World Championship was dropped after Punk's contract was terminated following the August 27 All In backstage incident.",
      "related": [
        "Real World Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    },
    {
      "date": "2026-01-16",
      "kind": "promotion",
      "text": "MJF defended the title on the independent circuit for the first time, retaining over Alec Price at Limitless Rumble.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    },
    {
      "date": "2026-07-08",
      "kind": "replaced-by",
      "text": "Kenny Omega defeated MJF in a Last Chance match at Dynamite: Beach Break to win the title.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    },
    {
      "date": "2026-08",
      "kind": "recognition",
      "text": "MJF returned at Grand Slam Mexico with his custom Triple B belt, calling himself the \"one true champion,\" which AEW has not officially recognized.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_World_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/List_of_AEW_World_Champions",
