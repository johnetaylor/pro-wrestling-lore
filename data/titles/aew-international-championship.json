  "history": [
    {
      "date": "2023-03-15",
      "kind": "brand",
      "text": "Renamed from All-Atlantic to International after Cassidy's final All-Atlantic defense.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_International_Championship"
      ]
    },
    {
      "date": "2023-03-15",
      "kind": "recognition",
      "text": "AEW initially treated the renamed title as new, but its history was later amended to show one continuous lineage.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_International_Championship"
      ]
    },
    {
      "date": "2024-07-24",
      "kind": "brand",
      "text": "MJF unofficially renamed it the AEW American Championship and introduced a custom belt.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_International_Championship"
      ]
    },
    {
      "date": "2024-08-25",
      "kind": "brand",
      "text": "Ospreay's win at All In restored the International Championship name.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_International_Championship"
      ]
    },
    {
      "date": "2025-07-12",
      "kind": "unified-into",
      "text": "Okada beat Omega at All In to win the Unified Championship, with both original lineages kept intact.",
      "related": [
        "AEW Continental Championship",
        "AEW Unified Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_International_Championship"
      ]
    },
    {
      "date": "2025-12-27",
      "kind": "split",
      "text": "Moxley's win over Okada in the Continental Classic final ended the unification, and Okada relinquished the Unified Championship.",
      "related": [
        "AEW Continental Championship",
        "AEW Unified Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_International_Championship"
      ]
    }
  ],
