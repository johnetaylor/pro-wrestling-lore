  "history": [
    {
      "date": "1983",
      "kind": "promotion",
      "text": "The WWF disaffiliated from the NWA.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "1984",
      "kind": "promotion",
      "text": "Moolah sold the title's rights to the WWF, and it became the WWF Women's Championship.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "1984",
      "kind": "recognition",
      "text": "WWE does not recognize title changes from 1956 to 1984, though the NWA does.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "1990",
      "kind": "deactivated",
      "text": "The title became inactive after Rockin' Robin vacated it when she left the WWF.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "1993-12-13",
      "kind": "reactivated",
      "text": "Alundra Blayze won a tournament for the vacant title, reactivating it.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "1995",
      "kind": "deactivated",
      "text": "The title became inactive again after Blayze was released; she later threw the belt in a trash can on WCW Monday Nitro.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "1998-09",
      "kind": "reactivated",
      "text": "Jacqueline Moore defeated Sable to reactivate the title during the Attitude Era.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "2002-03",
      "kind": "brand",
      "text": "After the WWE Brand Extension, the title was defended on both Raw and SmackDown.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "2002-09-23",
      "kind": "brand",
      "text": "The title became exclusive to Raw.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "2008-07-04",
      "kind": "split",
      "text": "The Divas Championship was created as a SmackDown counterpart, while the Women's Championship remained the only women's title.",
      "related": [
        "WWE Divas Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "2009-04-13",
      "kind": "brand",
      "text": "Champion Melina was drafted to SmackDown, making the title exclusive to SmackDown.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "2010-09-19",
      "kind": "unified-into",
      "text": "At Night of Champions, the title was unified with the Divas Championship, creating the Unified WWE Divas Championship.",
      "related": [
        "WWE Divas Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "2010-09-19",
      "kind": "retired",
      "text": "The Women's Championship was retired, and its lineage passed to the Divas Championship.",
      "related": [
        "WWE Divas Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    },
    {
      "date": "2016-04-03",
      "kind": "replaced-by",
      "text": "The new WWE Women's Championship was introduced at WrestleMania 32 to succeed the Divas Championship, without the original's lineage.",
      "related": [
        "WWE Divas Championship",
        "WWE Women's Championship (2016)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship_(1956%E2%80%932010)"
      ]
    }
