  "history": [
    {
      "date": "2020-09-10",
      "kind": "brand",
      "text": "- | Title created as a secondary NXT UK championship when the brand relaunched after a COVID-19 production hiatus.",
      "related": [
        "NXT UK"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    },
    {
      "date": "2022-08",
      "kind": "brand",
      "text": "- | WWE announced NXT UK would go on hiatus after Worlds Collide, with the brand to relaunch as NXT Europe at a later date.",
      "related": [
        "NXT UK",
        "NXT Europe"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    },
    {
      "date": "2022-09-04",
      "kind": "unified-into",
      "text": "- | Other NXT UK titles were unified into their NXT counterparts at Worlds Collide; the Heritage Cup was the only title not contested there.",
      "related": [
        "other NXT UK championships",
        "NXT championships"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    },
    {
      "date": "2022-08-25",
      "kind": "recognition",
      "text": "WWE recognizes Noam Dar's second reign as lasting 292 days due to tape delay, not the 341 days shown on the broadcast timeline.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    },
    {
      "date": "2023-04-04",
      "kind": "brand",
      "text": "- | Title was transferred from NXT UK to NXT when Dar appeared with it on NXT.",
      "related": [
        "NXT UK",
        "NXT"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    },
    {
      "date": "2023-04-04",
      "kind": "reactivated",
      "text": "- | Title returned after months of inactivity when Dar appeared with it on NXT and said he would defend it whenever he wanted.",
      "related": [
        "NXT"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    },
    {
      "date": "2023-04-18",
      "kind": "recognition",
      "text": "- | WWE officially renamed the title NXT Heritage Cup.",
      "related": [
        "NXT UK Heritage Cup",
        "NXT Heritage Cup"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    },
    {
      "date": "2025-06-21",
      "kind": "interim",
      "text": "Noam Dar vacated the title due to injury, and an interim champion was set to be crowned, with Channing \"Stacks\" Lorenzo winning it on June 24, 2025.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    },
    {
      "date": "2025-07-12",
      "kind": "deactivated",
      "text": "Tony D'Angelo stole the Cup and threw it off a bridge during The Great American Bash, after which it was not seen on TV again; WWE.com kept listing it as active.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    },
    {
      "date": "2026-06-03",
      "kind": "retired",
      "text": "WWE updated its website to list the title as retired, ending Lorenzo's reign and dating the official retirement to July 12, 2025.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Heritage_Cup"
      ]
    }
  ],
