  "history": [
    {
      "date": "1991-10-27",
      "kind": "recognition",
      "text": "Created as the WCW Light Heavyweight Championship; Brian Pillman won the tournament final",
      "related": [
        "WCW Light Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Cruiserweight_Championship_(1996%E2%80%932007)"
      ]
    },
    {
      "date": "1992-09-02",
      "kind": "deactivated",
      "text": "Brad Armstrong relinquished the title due to injury, and it became inactive",
      "related": [
        "WCW Light Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Cruiserweight_Championship_(1996%E2%80%932007)"
      ]
    },
    {
      "date": "1996-03-20",
      "kind": "recognition",
      "text": "WCW treated the two titles as distinct; WWE later considered them one lineage",
      "related": [
        "WCW Light Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Cruiserweight_Championship_(1996%E2%80%932007)"
      ]
    },
    {
      "date": "2001-03",
      "kind": "promotion",
      "text": "WWF purchased WCW",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Cruiserweight_Championship_(1996%E2%80%932007)"
      ]
    },
    {
      "date": "2001-11",
      "kind": "replaces",
      "text": "Renamed the WWF Cruiserweight Championship after Survivor Series, replacing the WWF Light Heavyweight Championship",
      "related": [
        "WWF Light Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Cruiserweight_Championship_(1996%E2%80%932007)"
      ]
    },
    {
      "date": "2002-03-25",
      "kind": "brand",
      "text": "Became exclusive to the SmackDown! brand after the brand split",
      "related": [
        "SmackDown!"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Cruiserweight_Championship_(1996%E2%80%932007)"
      ]
    },
    {
      "date": "2007-09-28",
      "kind": "retired",
      "text": "Vacated after Hornswoggle was stripped of the title by Vickie Guerrero; WWE lists the retirement year as 2007",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Cruiserweight_Championship_(1996%E2%80%932007)"
      ]
    },
    {
      "date": "2016",
      "kind": "recognition",
      "text": "A separate WWE Cruiserweight Championship was created; it did not carry this title's lineage",
      "related": [
        "NXT Cruiserweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Cruiserweight_Championship_(1996%E2%80%932007)"
      ]
    }
  ],
