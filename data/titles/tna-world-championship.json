{
  "id": "tna-world-championship",
  "name": "TNA World Championship",
  "promotion": "tna",
  "division": "men",
  "format": "singles",
  "established": "2007-05-13",
  "names": [
    "Impact World Championship",
    "TNA World Heavyweight Championship"
  ],
  "history": [
    {
      "date": "2007-05-13",
      "kind": "replaces",
      "text": "TNA's NWA-controlled title ended when the NWA agreement expired, and TNA created its own world title.",
      "related": [
        "NWA World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2017",
      "kind": "unified-into",
      "text": "Unified with the GFW Global Championship at Slammiversary XV into the Unified GFW World Heavyweight Championship.",
      "related": [
        "GFW Global Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2017",
      "kind": "brand",
      "text": "After Destination X, the title took the GFW Global Championship name and kept the former TNA lineage.",
      "related": [
        "GFW Global Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2017-10-23",
      "kind": "brand",
      "text": "The GFW name was dropped and the title became the Impact Global Championship (the article also gives September 2017 for this change).",
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2018-02-01",
      "kind": "brand",
      "text": "The title was renamed the Impact World Championship on Impact!.",
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2018-06-04",
      "kind": "absorbed",
      "text": "Unified with the Impact Grand Championship, which was then officially retired.",
      "related": [
        "Impact Grand Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2020-04",
      "kind": "split",
      "text": "Moose declared himself champion of a separate TNA World Heavyweight title, which Impact did not initially recognize.",
      "related": [
        "TNA World Heavyweight Championship (2020–2021)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2021-02-23",
      "kind": "recognition",
      "text": "Impact executive vice president Scott D'Amore officially sanctioned Moose's title.",
      "related": [
        "TNA World Heavyweight Championship (2020–2021)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2021-03-13",
      "kind": "absorbed",
      "text": "Rich Swann defeated Moose at Sacrifice to unify the titles, and the TNA title was deactivated.",
      "related": [
        "TNA World Heavyweight Championship (2020–2021)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2021-03-13",
      "kind": "deactivated",
      "text": "The TNA title was deactivated after the unification, and the unified title was briefly called the Impact Unified World Championship.",
      "related": [
        "TNA World Heavyweight Championship (2020–2021)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2021-08",
      "kind": "retired",
      "text": "The TNA belt was retired again after Christian Cage won the title.",
      "related": [
        "TNA World Heavyweight Championship (2020–2021)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    },
    {
      "date": "2024-01",
      "kind": "brand",
      "text": "The company reverted to the TNA name, and the title became the TNA World Championship with a new belt.",
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Championship"
      ]
    }
  ],
