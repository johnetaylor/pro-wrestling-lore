    }
  ],
  "history": [
    {
      "date": "1961",
      "kind": "recognition",
      "text": "Irma González was billed as defending the \"Occidente\" title; researchers concluded it was likely her women's championship under another label.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1986",
      "kind": "recognition",
      "text": "The Mexico City commission officially recognized Reyna Gallegos as champion and adopted the title's lineage retroactively.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1986",
      "kind": "promotion",
      "text": "The commission allowed EMLL to promote the title, and promoters in Mexico City could petition to have the champion work their shows.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1988-03-30",
      "kind": "reactivated",
      "text": "La Briosa won the title in a tournament final after the title was vacated in 1988.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1988",
      "kind": "deactivated",
      "text": "The title was vacated when Reyna Gallegos retired.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1991-02-12",
      "kind": "deactivated",
      "text": "The title was vacated when Zuleyma won the UWA World Women's Championship.",
      "related": [
        "UWA World Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1991-11-07",
      "kind": "reactivated",
      "text": "Neftali won the vacant title by defeating Vicky Carranza.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1993-01",
      "kind": "deactivated",
      "text": "The title was vacated when La Sirenita became pregnant.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1993-10-10",
      "kind": "deactivated",
      "text": "The title was vacated when La Diabólica won the CMLL World Women's Championship.",
      "related": [
        "CMLL World Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1994-01-18",
      "kind": "reactivated",
      "text": "La Sirenita won the vacant title by defeating Maria del Angel.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1995-11-25",
      "kind": "promotion",
      "text": "Martha Villalobos won the title on an AAA show, moving control of the title from CMLL to AAA.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "1996-06-21",
      "kind": "reactivated",
      "text": "Martha Villalobos won the vacant title by defeating La Practicante.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "2007-04-15",
      "kind": "deactivated",
      "text": "The title was vacated four months after Lady Apache won the CMLL World Women's Championship.",
      "related": [
        "CMLL World Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "2007-05-04",
      "kind": "reactivated",
      "text": "Marcela won the vacant title in a tournament final; CMLL later adopted the championship.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "2023-06-14",
      "kind": "deactivated",
      "text": "The title was vacated because Dark Silueta was injured and wanted to tour Japan.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    },
    {
      "date": "2023-07-14",
      "kind": "reactivated",
      "text": "Reyna Isis won the vacant title by defeating Lluvia.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Women%27s_Championship"
      ]
    }
  ],
