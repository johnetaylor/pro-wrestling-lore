  "names": [
    "Mexican Women's Championship",
    "Occidente Women's Championship"
  ],
  "eras": [
    {
      "name": "Mexican Women's Championship",
      "from": "1955",
      "to": "1961"
    },
    {
      "name": "Occidente Women's Championship",
