  "history": [
    {
      "date": "1987",
      "kind": "deactivated",
      "text": "The original version was deactivated in 1987, and Inoki was recognized as the first champion of the new version.",
      "related": [
        "IWGP Heavyweight Championship (original version)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "1987-06-12",
      "kind": "replaces",
      "text": "The new version was introduced as the prize of the 1987 IWGP League tournament.",
      "related": [
        "IWGP Heavyweight Championship (original version)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2004-01-04",
      "kind": "absorbed",
      "text": "The NWF title was unified into the IWGP title when Shinsuke Nakamura defeated Yoshihiro Takayama at Wrestling World 2004.",
      "related": [
        "NWF Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2007",
      "kind": "recognition",
      "text": "TNA recognized Kurt Angle as \"IWGP Heavyweight Champion,\" while NJPW called him the \"IWGP 3rd Belt Champion\" after he won the IGF title.",
      "related": [
        "IWGP Heavyweight Championship (IGF)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2008-02-17",
      "kind": "absorbed",
      "text": "Shinsuke Nakamura defeated Kurt Angle to unify the NJPW and IGF versions of the title.",
      "related": [
        "IWGP Heavyweight Championship (IGF)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2012",
      "kind": "promotion",
      "text": "Bushiroad bought NJPW, and Gedo became head booker, marking a change in the title's booking direction.",
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2020-01-05",
      "kind": "recognition",
      "text": "Tetsuya Naito became the first double champion, holding both titles, which were defended together but kept separate histories.",
      "related": [
        "IWGP Intercontinental Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2021-03-04",
      "kind": "unified-into",
      "text": "The Heavyweight and Intercontinental titles were unified to form the IWGP World Heavyweight Championship.",
      "related": [
        "IWGP Intercontinental Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2021-03-04",
      "kind": "deactivated",
      "text": "NJPW considered both the Heavyweight and Intercontinental titles deactivated while the World title was active.",
      "related": [
        "IWGP Heavyweight Championship",
        "IWGP Intercontinental Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2022-01-04",
      "kind": "replaced-by",
      "text": "After winning the World title at Wrestle Kingdom 16, Kazuchika Okada chose to be recognized as World champion rather than revive the Heavyweight title.",
      "related": [
        "IWGP World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2026-01-06",
      "kind": "retired",
      "text": "Yota Tsuji officially retired the World title, declaring himself Heavyweight champion and merging the two lineages.",
      "related": [
        "IWGP World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    },
    {
      "date": "2026-01-06",
      "kind": "reactivated",
      "text": "The Heavyweight title was revived with its lineage combined with the World and Intercontinental title histories, and Tsuji was recognized as the 87th champion.",
      "related": [
        "IWGP World Heavyweight Championship",
        "IWGP Intercontinental Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/IWGP_Heavyweight_Championship"
      ]
    }
  ],
