  "history": [
    {
      "date": "2007-05-13",
      "kind": "split",
      "text": "The NWA ended its five-year agreement with TNA, which had given TNA control of the NWA tag title, and Team 3D was stripped of it.",
      "related": [
        "NWA World Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "2017",
      "kind": "brand",
      "text": "At Destination X, a recolored version of the GFW tag belts was revealed as the new championship design.",
      "related": [
        "GFW World Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "2024-01-13",
      "kind": "brand",
      "text": "At Hard to Kill, the new belts debuted as part of Impact Wrestling's rebrand back to TNA Wrestling.",
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "2024-01-13",
      "kind": "replaced-by",
      "text": "New belts were introduced and used for the first time, replacing the Impact-era championship.",
      "related": [
        "Impact World Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/TNA_World_Tag_Team_Championship"
      ]
    }
