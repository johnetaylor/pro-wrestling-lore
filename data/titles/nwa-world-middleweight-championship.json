{
  "id": "nwa-world-middleweight-championship",
  "name": "NWA World Middleweight Championship",
  "promotion": "cmll",
  "division": "men",
  "format": "singles",
  "established": "1939",
  "retired": "2010-08-12",
  "names": [
    "World Middleweight Championship"
  ],
  "eras": [
    {
      "name": "World Middleweight Championship",
      "from": "1939",
      "to": "1952"
    },
    {
      "name": "NWA World Middleweight Championship",
      "from": "1952"
    }
  ],
  "history": [
    {
      "date": "1939-03-29",
      "kind": "absorbed",
      "text": "Octavio Gaona beat Kallio and won both middleweight titles; the NWA Association title was later retired in 1940.",
      "related": [
        "National Wrestling Association World Middleweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "1940-02-04",
      "kind": "absorbed",
      "text": "Tarzán López won both versions, leaving only the EMLL version active.",
      "related": [
        "National Wrestling Association World Middleweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "1952",
      "kind": "recognition",
      "text": "EMLL joined the National Wrestling Alliance, and the belt was prefixed with \"NWA.\"",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "1994-11-08",
      "kind": "promotion",
      "text": "Último Dragón bought the title and its booking rights from CMLL and won it in Tokyo, promoting it exclusively in Japan.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "1998",
      "kind": "deactivated",
      "text": "Último Dragón vacated the title due to an arm injury.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "1999-02-07",
      "kind": "reactivated",
      "text": "The Great Sasuke won a tournament final to revive the vacant title.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "2003",
      "kind": "promotion",
      "text": "After Último Dragón signed with WWE, he returned the title to CMLL.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "2004-09-03",
      "kind": "reactivated",
      "text": "Averno beat Zumbido for the vacant title, CMLL's first match for the title since 1994.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "2010-03",
      "kind": "recognition",
      "text": "Blue Demon Jr., president of NWA Mexico, declared the NWA titles vacated; CMLL ignored the demand.",
      "related": [
        "NWA World Welterweight Championship",
        "NWA World Light Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "2010-08-12",
      "kind": "replaced-by",
      "text": "CMLL unveiled the NWA World Historic Middleweight Championship to replace this title, which it conceded to NWA Mexico.",
      "related": [
        "NWA World Historic Middleweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    },
    {
      "date": "2010-08-12",
      "kind": "retired",
      "text": "The original championship was retired when CMLL returned it to the NWA.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/NWA_World_Middleweight_Championship"
