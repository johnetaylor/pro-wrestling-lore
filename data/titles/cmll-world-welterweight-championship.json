  "history": [
    {
      "date": "1996-05-07",
      "kind": "recognition",
      "text": "CMLL did not recognize La Pantera's loss to Super Delfin in Japan and declared the title vacant; a 16-man tournament crowned Máscara Mágica.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Welterweight_Championship"
      ]
    },
    {
      "date": "2014-11-19",
      "kind": "deactivated",
      "text": "Místico said he was not ready to return to the ring, and the title was declared vacant.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Welterweight_Championship"
      ]
    },
    {
      "date": "2014-12-26",
      "kind": "replaced-by",
      "text": "A 10-man torneo cibernetico was held to determine the next champion; Máscara Dorada won the title a week later.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Welterweight_Championship"
      ]
    },
    {
      "date": "2015",
      "kind": "recognition",
      "text": "Máscara Dorada took the title to New Japan Pro-Wrestling and lost it to Bushi there; CMLL officially acknowledged the change.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Welterweight_Championship"
      ]
    },
    {
      "date": "2019-12-01",
      "kind": "replaced-by",
      "text": "After CMLL fired Dragon Lee, a tournament began to crown a new champion; Titán defeated Soberano Jr. on December 8, 2019.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Welterweight_Championship"
      ]
    }
  ],
