  "history": [
    {
      "date": "2016-04-03",
      "kind": "replaces",
      "text": "The Divas Championship was retired and this title took its place as WWE's top women's title",
      "related": [
        "WWE Divas Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship"
      ]
    },
    {
      "date": "2016-07-19",
      "kind": "brand",
      "text": "Charlotte was drafted to Raw in the 2016 WWE Draft, making the title exclusive to Raw",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship"
      ]
    },
    {
      "date": "2016-09-05",
      "kind": "split",
      "text": "SmackDown created a counterpart title, and this title was renamed Raw Women's Championship",
      "related": [
        "SmackDown Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship"
      ]
    },
    {
      "date": "2019-09",
      "kind": "recognition",
      "text": "NXT was recognized as a third brand and its title as a third main women's title, a status reversed in September 2021",
      "related": [
        "NXT Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship"
      ]
    },
    {
      "date": "2023-05-08",
      "kind": "brand",
      "text": "The Raw and SmackDown women's titles switched brands in the 2023 WWE Draft, and this title moved to SmackDown",
      "related": [
        "SmackDown Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship"
      ]
    },
    {
      "date": "2023-06-09",
      "kind": "split",
      "text": "The title reverted to the WWE Women's Championship name with a new belt, while the SmackDown title was later renamed Women's World Championship on June 12",
      "related": [
        "Women's World Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship"
      ]
    },
    {
      "date": "2026-08-02",
      "kind": "interim",
      "text": "Chelsea Green became interim champion in a five-way ladder match at SummerSlam after Rhea Ripley's injury, while Ripley remains lineal champion",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Women%27s_Championship"
      ]
    }
  ],
