{
  "id": "nwa-world-light-heavyweight-championship",
  "name": "NWA World Light Heavyweight Championship",
  "promotion": "cmll",
  "division": "men",
  "format": "singles",
  "established": "1952-11-06",
  "retired": "2014-02-26",
  "names": [],
  "history": [
    {
      "date": "1957-11-30",
      "kind": "deactivated",
      "text": "NWA stripped Frank Stojack of the title for lacking NWA-mandated defenses; he kept the physical belt and defended it for over a year.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "1958",
      "kind": "promotion",
      "text": "After Stojack's stripping, the NWA executive board gave control of the title to Salvador Lutteroth and EMLL.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "1958",
      "kind": "reactivated",
      "text": "Dory Dixon won the vacant title under EMLL's authority, reviving the championship.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "1977",
      "kind": "brand",
      "text": "The title was also defended in the Los Angeles area in the late 1970s and early 1980s, and was promoted by NWA Hollywood Wrestling until its closure in 1982.",
      "related": [
        "NWA Hollywood Wrestling"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "1997",
      "kind": "recognition",
      "text": "The NWA endorsed a separate \"New Jersey version\" of the title in 1997 and 1998, which was not connected to the CMLL version.",
      "related": [
        "NWA World Light Heavyweight Championship (New Jersey version)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "2010-08-12",
      "kind": "replaced-by",
      "text": "CMLL returned the old title to the NWA and debuted the NWA World Historic Light Heavyweight Championship as its replacement.",
      "related": [
        "NWA World Historic Light Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "2013-05-19",
      "kind": "reactivated",
      "text": "NWA Mexico crowned its first recognized champion, Súper Nova, who won the vacant title in a tournament final.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "2013-05-19",
      "kind": "recognition",
      "text": "Súper Nova was recognized by NWA Mexico and IWRG but not by the NWA in the United States.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "2014-02-26",
      "kind": "deactivated",
      "text": "Súper Nova's last known defense occurred at an IWRG event; no defenses occurred afterward, and the title was de facto retired.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/NWA_World_Light_Heavyweight_Championship"
  ],
