  "history": [
    {
      "date": "1952",
      "kind": "recognition",
      "text": "EMLL joined the NWA and the championship received the \"NWA\" prefix.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Historic_Welterweight_Championship"
      ]
    },
    {
      "date": "1992",
      "kind": "promotion",
      "text": "EMLL was renamed Consejo Mundial de Lucha Libre (CMLL) as a separate entity after leaving the NWA.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Historic_Welterweight_Championship"
      ]
    },
    {
      "date": "1992-05",
      "kind": "deactivated",
      "text": "Misterioso left CMLL and the NWA World Welterweight Championship was vacated; CMLL did not promote it for about three years.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Historic_Welterweight_Championship"
      ]
    },
    {
      "date": "1995",
      "kind": "reactivated",
      "text": "CMLL brought back the NWA World Welterweight Championship in the winter of 1995, with Negro Casas winning it.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Historic_Welterweight_Championship"
      ]
    },
    {
      "date": "1996-08",
      "kind": "unified-into",
      "text": "Negro Casas lost the championship in a tournament creating the J-Crown, which unified eight championships as one.",
      "related": [
        "J-Crown"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Historic_Welterweight_Championship"
      ]
    },
    {
      "date": "1996",
      "kind": "brand",
      "text": "From 1996 through 2007 the championship was promoted in Japan.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Historic_Welterweight_Championship"
      ]
    },
    {
      "date": "2007-11-27",
      "kind": "promotion",
      "text": "La Sombra defeated Hajime Ohara to bring the championship back to CMLL.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Historic_Welterweight_Championship"
      ]
    },
    {
      "date": "2010",
      "kind": "recognition",
      "text": "NWA Mexico asked CMLL to stop using NWA-branded titles because CMLL was no longer part of the NWA; CMLL did not respond directly.",
      "related": [
        "NWA World Welterweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Historic_Welterweight_Championship"
      ]
    },
    {
      "date": "2010-08-12",
      "kind": "replaces",
      "text": "CMLL debuted the new belt, renamed the title NWA World Historic Welterweight Championship, and named Mephisto the first champion.",
      "related": [
        "NWA World Welterweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Historic_Welterweight_Championship"
      ]
    }
  ],
