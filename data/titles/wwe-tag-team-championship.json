  "history": [
    {
      "date": "2016-08-23",
      "kind": "replaces",
      "text": "Introduced for SmackDown as a second tag title after the previous WWE Tag Team Championship became Raw-exclusive in the 2016 draft.",
      "related": [
        "WWE Tag Team Championship (renamed Raw Tag Team Championship)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Tag_Team_Championship"
      ]
    },
    {
      "date": "2022-05-20",
      "kind": "unified-into",
      "text": "The Usos beat RK-Bro in a Winners Take All match, billed as unification, though both titles stayed independently active.",
      "related": [
        "Raw Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Tag_Team_Championship"
      ]
    },
    {
      "date": "2024-04-06",
      "kind": "split",
      "text": "A Six-Pack Tag Team Ladder match at WrestleMania XL Night 1 split the Undisputed titles, with A-Town Down Under winning this one.",
      "related": [
        "Raw Tag Team Championship (World Tag Team Championship)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Tag_Team_Championship"
      ]
    },
    {
      "date": "2020",
      "kind": "recognition",
      "text": "Big E was recognized as champion under the Freebird Rule for the first six reigns but not the seventh, after he was split from the team in the 2020 draft.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Tag_Team_Championship"
      ]
    }
  ],
