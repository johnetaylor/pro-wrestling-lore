  "history": [
    {
      "date": "1987-04-04",
      "kind": "deactivated",
      "text": "Title vacated after Dick Murdoch was suspended by the NWA, and Murdoch and Ivan Koloff were stripped.",
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_United_States_Tag_Team_Championship"
      ]
    },
    {
      "date": "1988",
      "kind": "promotion",
      "text": "Crockett sold Jim Crockett Promotions to Ted Turner, who founded WCW as its successor; the title kept the NWA name.",
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_United_States_Tag_Team_Championship"
      ]
    },
    {
      "date": "1988-09-10",
      "kind": "deactivated",
      "text": "The NWA vacated the title after Eaton and Lane won the NWA World Tag Team Championship.",
      "related": [
        "NWA World Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_United_States_Tag_Team_Championship"
      ]
    },
    {
      "date": "1989-05-01",
      "kind": "deactivated",
      "text": "The NWA abandoned the title after Eddie Gilbert and Rick Steiner split, so Rick could team with Scott Steiner.",
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_United_States_Tag_Team_Championship"
      ]
    },
    {
      "date": "1990-02-12",
      "kind": "reactivated",
      "text": "The title was revived, with Brian Pillman and The Z-Man winning a tournament final over the Fabulous Freebirds.",
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_United_States_Tag_Team_Championship"
      ]
    },
    {
      "date": "1991-01",
      "kind": "brand",
      "text": "The title was rebranded as a WCW-controlled title, though the belts kept the NWA initials.",
      "related": [
        "WCW World Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_United_States_Tag_Team_Championship"
      ]
    },
    {
      "date": "1991-04-06",
      "kind": "deactivated",
      "text": "Title vacated because The Steiner Brothers won the WCW World Tag Team Championship during their reign.",
      "related": [
        "WCW World Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_United_States_Tag_Team_Championship"
      ]
    },
    {
      "date": "1991-05-19",
      "kind": "reactivated",
      "text": "The Fabulous Freebirds won the vacant title in a Top Contenders match against The Young Pistols.",
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_United_States_Tag_Team_Championship"
      ]
    },
    {
      "date": "1992-07-31",
      "kind": "retired",
      "text": "WCW stripped The Barbarian and Dick Slater and retired the title to focus on the WCW World Tag Team Championship.",
      "related": [
        "WCW World Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_United_States_Tag_Team_Championship"
      ]
    }
  ],
