  "history": [
    {
      "date": "1993-09-15",
      "kind": "recognition",
      "text": "The NWA withdrew recognition when WCW left the organization, and Flair remained recognized as World Heavyweight Champion by WCW.",
      "related": [
        "NWA World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_International_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1993-09-15",
      "kind": "promotion",
      "text": "WCW kept the physical belt after leaving the NWA, and the title was later presented as a title of the fictitious WCW International.",
      "related": [
        "NWA World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_International_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1994-05-22",
      "kind": "recognition",
      "text": "WCW voided Rude's May 1, 1994 win at Slamboree, but WWE still recognizes that reign.",
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_International_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1994-05-22",
      "kind": "interim",
      "text": "The title was vacated at Slamboree, and Sting won a bout for the vacant championship later that night.",
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_International_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1994-06-23",
      "kind": "unified-into",
      "text": "Flair defeated Sting at Clash of the Champions XXVII, unifying the two titles, and the belt was renamed the WCW World Title.",
      "related": [
        "WCW World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_International_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1994-06-23",
      "kind": "retired",
      "text": "The WCW International World Heavyweight Championship ended when it was unified with the WCW World Heavyweight Championship.",
      "related": [
        "WCW World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_International_World_Heavyweight_Championship"
      ]
    }
