  "history": [
    {
      "date": "2016-07-19",
      "kind": "split",
      "text": "The 2016 draft reintroduced the brand split and made the WWE Championship exclusive to SmackDown.",
      "related": [
        "WWE Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Universal_Championship"
      ]
    },
    {
      "date": "2019-10-31",
      "kind": "brand",
      "text": "Bray Wyatt won the title at Crown Jewel, moving it to SmackDown.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Universal_Championship"
      ]
    },
    {
      "date": "2019-11-01",
      "kind": "brand",
      "text": "Brock Lesnar quit SmackDown, taking the WWE Championship to Raw.",
      "related": [
        "WWE Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Universal_Championship"
      ]
    },
    {
      "date": "2022-04-03",
      "kind": "unified-into",
      "text": "Roman Reigns beat Brock Lesnar at WrestleMania 38 Night 2 to become Undisputed champion, though both lineages stayed separate despite being billed as a unification.",
      "related": [
        "WWE Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Universal_Championship"
      ]
    },
    {
      "date": "2023-04-28",
      "kind": "brand",
      "text": "Reigns was drafted to SmackDown, making the undisputed titles SmackDown-exclusive, and a new World Heavyweight Championship was assigned to Raw.",
      "related": [
        "World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Universal_Championship"
      ]
    },
    {
      "date": "2023-06-02",
      "kind": "replaced-by",
      "text": "A new single Undisputed WWE Universal Championship belt was presented to Reigns on SmackDown.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Universal_Championship"
      ]
    },
    {
      "date": "2024-04-07",
      "kind": "deactivated",
      "text": "The Universal Championship was decommissioned after Reigns lost to Cody Rhodes at WrestleMania XL Night 2, while the WWE Championship lineage continued.",
      "related": [
        "WWE Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Universal_Championship"
      ]
    },
    {
      "date": "2025-04-21",
      "kind": "retired",
      "text": "The title history was amended to remove Rhodes and retire the Universal Championship with Reigns as final champion, following Rhodes's loss to John Cena at WrestleMania 41.",
      "related": [
        "WWE Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Universal_Championship"
      ]
    },
    {
      "date": "2025-04-21",
      "kind": "recognition",
      "text": "Rhodes was initially listed as the final champion, but WWE later removed him from the title history and recognized Reigns instead.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Universal_Championship"
      ]
    }
  ],
