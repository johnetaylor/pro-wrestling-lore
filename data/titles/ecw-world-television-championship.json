  "history": [
    {
      "date": "1993-01",
      "kind": "recognition",
      "text": "ECW seceded from the NWA in January 1993, ending its NWA affiliation.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Television_Championship"
      ]
    },
    {
      "date": "1994-09",
      "kind": "promotion",
      "text": "ECW officially left the NWA and became Extreme Championship Wrestling, and the title took the name ECW World Television Championship.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Television_Championship"
      ]
    },
    {
      "date": "2001-04-11",
      "kind": "retired",
      "text": "The title was retired when ECW closed down.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Television_Championship"
      ]
    },
    {
      "date": "2006",
      "kind": "brand",
      "text": "WWE relaunched ECW as a brand, but did not revive this title and instead revived the ECW World Heavyweight Championship.",
      "related": [
        "ECW World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Television_Championship"
      ]
    }
  ],
