  "history": [
    {
      "date": "1992",
      "kind": "promotion",
      "text": "Máscara Sagrada took the title from EMLL to AAA when he left with Antonio Peña, and AAA then had exclusive control until 2002.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "2002",
      "kind": "promotion",
      "text": "El Dandy's 2002 win moved the title to ENSEMA; the table's ENSEMA section dates the change to 2004.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "2007-12-04",
      "kind": "promotion",
      "text": "Místico won the title from Vangelis, and CMLL has held exclusive rights since December 2007.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Light_Heavyweight_Championship"
