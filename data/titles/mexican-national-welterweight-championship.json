{
  "id": "mexican-national-welterweight-championship",
  "name": "Mexican National Welterweight Championship",
  "promotion": "cmll",
  "division": "men",
  "format": "singles",
  "established": "1934-06-17",
  "names": [],
  "history": [
    {
      "date": "1992-08-16",
      "kind": "promotion",
      "text": "AAA took over promotion of the title from CMLL and promoted it for the next six years.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Welterweight_Championship"
      ]
    },
    {
      "date": "1992-08-16",
      "kind": "interim",
      "text": "AAA's 16-man tournament crowned Ciclón Ramírez after El Felino vacated the title.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Welterweight_Championship"
      ]
    },
    {
      "date": "1998-09-25",
      "kind": "promotion",
      "text": "CMLL regained control after Arkangel de la Muerte beat El Toreo on a CMLL show; CMLL has promoted it exclusively since.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Welterweight_Championship"
      ]
    },
    {
      "date": "2013-03-21",
      "kind": "deactivated",
      "text": "Vacated when Titán could not defend the title due to a long-term injury (text gives March 20, table gives March 21).",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Welterweight_Championship"
      ]
    },
    {
      "date": "2013-04-26",
      "kind": "interim",
      "text": "Torneo cibernetico filled the vacancy; Averno beat Místico La Nueva Era in the final.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Welterweight_Championship"
      ]
    },
    {
      "date": "2021-12-01",
      "kind": "deactivated",
      "text": "Soberano Jr. vacated the title to challenge for the CMLL World Welterweight Championship.",
      "related": [
        "CMLL World Welterweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Welterweight_Championship"
      ]
    },
    {
      "date": "2022-06-24",
      "kind": "interim",
      "text": "Torneo cibernetico won by Magia Blanca to fill the vacant title.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Welterweight_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/Mexican_National_Welterweight_Championship"
