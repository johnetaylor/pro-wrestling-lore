{
  "id": "roh-world-championship",
  "name": "ROH World Championship",
  "promotion": "roh",
  "division": "men",
  "format": "singles",
  "established": "2002-06-22",
  "names": [
    "ROH Championship (2002–2003)",
    "ROH World Championship (2003–present)",
    "Undisputed ROH World Championship"
  ],
  "eras": [
    {
      "name": "ROH Championship",
      "from": "2002",
      "to": "2003-05-17"
    },
    {
      "name": "ROH World Championship",
      "from": "2003-05-17",
      "to": "2022"
    },
    {
      "name": "Undisputed ROH World Championship",
      "from": "2022"
    }
  ],
  "history": [
    {
      "date": "2006-08-12",
      "kind": "absorbed",
      "text": "The ROH Pure Championship was unified into the ROH World Championship after Bryan Danielson beat Nigel McGuinness in Liverpool.",
      "related": [
        "ROH Pure Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_World_Championship"
      ]
    },
    {
      "date": "2013-07-03",
      "kind": "deactivated",
      "text": "The title was vacated for the first time after Nigel McGuinness stripped Jay Briscoe of it during a storyline injury.",
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_World_Championship"
      ]
    },
    {
      "date": "2021",
      "kind": "deactivated",
      "text": "Ring of Honor announced a hiatus after Final Battle, and the title was vacated.",
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_World_Championship"
      ]
    },
    {
      "date": "2021",
      "kind": "reactivated",
      "text": "At Final Battle, Jonathan Gresham won the vacated title from Jay Lethal, who replaced the injured Bandido.",
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_World_Championship"
      ]
    },
    {
      "date": "2022",
      "kind": "unified-into",
      "text": "At Supercard of Honor XV, Jonathan Gresham beat Bandido to unify the two versions of the ROH World Championship.",
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_World_Championship"
      ]
    },
    {
      "date": "2023",
      "kind": "recognition",
      "text": "Eddie Kingston won the AEW Continental Classic and held all three titles, becoming the first Continental Crown (American Triple Crown) champion.",
      "related": [
        "AEW Continental Championship",
        "Strong Openweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_World_Championship"
      ]
    },
    {
      "date": "2024-03-20",
      "kind": "recognition",
      "text": "Kingston lost the AEW Continental Championship to Kazuchika Okada, ending his Triple Crown recognition.",
      "related": [
        "AEW Continental Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_World_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/List_of_ROH_World_Champions",
    "https://en.wikipedia.org/wiki/ROH_World_Championship"
  ],
