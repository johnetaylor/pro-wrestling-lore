    {
      "date": "1998-05-14",
      "kind": "recognition",
      "text": "Billed as \"unrecognized\" by ECW, presented as an outlaw title not sanctioned in-storyline.",
      "sources": [
        "https://en.wikipedia.org/wiki/FTW_Championship"
      ]
    },
    {
      "date": "1999-03-21",
      "kind": "unified-into",
      "text": "Taz beat Sabu in a title vs. title match and unified the FTW title into the ECW World Heavyweight Championship, retiring the FTW title.",
      "related": [
        "ECW World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/FTW_Championship"
      ]
    },
    {
      "date": "2001",
      "kind": "promotion",
      "text": "The title was not included in the intellectual property sold to WWE in the ECW sale, so Taz kept its rights.",
      "sources": [
        "https://en.wikipedia.org/wiki/FTW_Championship"
      ]
    },
    {
      "date": "2020-07-02",
      "kind": "reactivated",
      "text": "Taz revived the title as the FTW Championship in AEW and awarded it to Brian Cage when Jon Moxley's match was postponed.",
      "sources": [
        "https://en.wikipedia.org/wiki/FTW_Championship"
      ]
    },
    {
      "date": "2020-07-02",
      "kind": "recognition",
      "text": "The FTW Championship was not an officially sanctioned AEW championship, mirroring its status in ECW.",
      "sources": [
        "https://en.wikipedia.org/wiki/FTW_Championship"
      ]
    },
    {
      "date": "2024-09-25",
      "kind": "retired",
      "text": "After a successful defense against Roderick Strong, Hook retired the title and returned it to Taz.",
      "sources": [
        "https://en.wikipedia.org/wiki/FTW_Championship"
      ]
    }
