  "history": [
    {
      "date": "2016-08-23",
      "kind": "split",
      "text": "The 2016 draft sent the existing women's title to Raw, and a separate SmackDown title was created in its place.",
      "related": [
        "WWE Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Women%27s_World_Championship_(WWE)"
      ]
    },
    {
      "date": "2016",
      "kind": "replaces",
      "text": "Listed as the predecessor as WWE's top women's championship, held since 2016.",
      "related": [
        "WWE Divas Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Women%27s_World_Championship_(WWE)"
      ]
    },
    {
      "date": "2019-09",
      "kind": "recognition",
      "text": "NXT was recognized as a third main brand, which made its women's title a third main women's championship.",
      "related": [
        "NXT Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Women%27s_World_Championship_(WWE)"
      ]
    },
    {
      "date": "2021-09",
      "kind": "recognition",
      "text": "NXT's third-brand status was reversed and it returned to developmental status.",
      "related": [
        "NXT Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Women%27s_World_Championship_(WWE)"
      ]
    },
    {
      "date": "2021",
      "kind": "brand",
      "text": "In the 2021 draft, both women's champions were moved to the opposite brands, so they swapped titles to stay on their own brands.",
      "related": [
        "WWE Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Women%27s_World_Championship_(WWE)"
      ]
    },
    {
      "date": "2023-05-08",
      "kind": "brand",
      "text": "The 2023 draft switched this title and the Raw title between brands, leaving the titles on the wrong brands.",
      "related": [
        "WWE Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Women%27s_World_Championship_(WWE)"
      ]
    }
  ],
