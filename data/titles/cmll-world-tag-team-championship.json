  "history": [
    {
      "date": "1993-03",
      "kind": "replaces",
      "text": "Created to replace the Mexican National Tag Team Championship after its champions left CMLL for AAA.",
      "related": [
        "Mexican National Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "1994-11",
      "kind": "deactivated",
      "text": "Vacated when El Canek left CMLL; a tournament later crowned new champions.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "1996-10-25",
      "kind": "deactivated",
      "text": "Los Headhunters were disqualified after the match and the title was declared vacant.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "1997-08",
      "kind": "deactivated",
      "text": "Vacated when Silver King left CMLL for WCW.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "1997-08-29",
      "kind": "reactivated",
      "text": "Dr. Wagner Jr. and Emilio Charles Jr. won a tournament to fill the vacancy.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "1998-10",
      "kind": "deactivated",
      "text": "Vacated when Mr. Niebla was injured.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "1998-11-13",
      "kind": "reactivated",
      "text": "Bestia Salvaje and Scorpio Jr. won a tournament to fill the vacancy.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "1999-02-05",
      "kind": "interim",
      "text": "Casas and Hijo del Santo won by disqualification, then vacated the title, which was held up until a rematch.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "2000-06-16",
      "kind": "deactivated",
      "text": "Vacated after El Hijo del Santo stopped working for CMLL.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "2000-08-04",
      "kind": "reactivated",
      "text": "Rey Bucanero and Último Guerrero were declared champions after a tournament.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "2013-09-18",
      "kind": "reactivated",
      "text": "Vacated when Rey Bucanero was injured, and La Máscara and Rush were awarded the title.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "2018-02-07",
      "kind": "deactivated",
      "text": "Negro Casas and Shocker were stripped of the title for lack of championship defenses.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Tag_Team_Championship"
      ]
    }
  ],
