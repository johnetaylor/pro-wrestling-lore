  "history": [
    {
      "date": "2004-07-17",
      "kind": "replaced-by",
      "text": "Styles vacated after TNA ended its talent-sharing deal with ROH; Doug Williams won the vacant title at Reborn: Completion.",
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_Pure_Championship"
      ]
    },
    {
      "date": "2006-08-12",
      "kind": "unified-into",
      "text": "Bryan Danielson defeated Nigel McGuinness in Liverpool to unify the Pure and World titles.",
      "related": [
        "ROH World Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_Pure_Championship"
      ]
    },
    {
      "date": "2006-08",
      "kind": "retired",
      "text": "After a later August 2006 draw with McGuinness, Danielson announced the Pure Championship was retired and gave the belt to McGuinness.",
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_Pure_Championship"
      ]
    },
    {
      "date": "2014-01",
      "kind": "recognition",
      "text": "ROH released a DVD describing Styles as the first Pure Champion, the first public acknowledgment of his Pure Wrestling reign in about a decade.",
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_Pure_Championship"
      ]
    },
    {
      "date": "2020-01-30",
      "kind": "reactivated",
      "text": "Ring of Honor announced the Pure Championship was being reinstated, with a tournament to crown a new champion.",
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_Pure_Championship"
      ]
    },
    {
      "date": "2023-03-31",
      "kind": "recognition",
      "text": "A new belt design debuted at Supercard of Honor, the second design in the title's history.",
      "sources": [
        "https://en.wikipedia.org/wiki/ROH_Pure_Championship"
      ]
    }
