  "history": [
    {
      "date": "2000-12",
      "kind": "deactivated",
      "text": "CMLL stopped promoting in Japan, and the Japan-era title was abandoned by the end of 2000.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    },
    {
      "date": "2003-09-12",
      "kind": "reactivated",
      "text": "Havana Brother I won a tournament final, reviving the title in Mexico, where CMLL also raised it to world-level status.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    },
    {
      "date": "2009-04-03",
      "kind": "deactivated",
      "text": "The title was officially declared vacant after Rocky Romero left CMLL for AAA.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    },
    {
      "date": "2009-04-07",
      "kind": "reactivated",
      "text": "Máscara Dorada won a torneo cibernetico to crown a new champion.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    },
    {
      "date": "2011",
      "kind": "brand",
      "text": "The division was adjusted from Super Lightweight to Lightweight, changing the weight limit and the title's name.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    },
    {
      "date": "2011-04-07",
      "kind": "deactivated",
      "text": "Máscara Dorada vacated the title after moving up to the middleweight division.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    },
    {
      "date": "2019-06-14",
      "kind": "deactivated",
      "text": "Dragon Lee vacated the title to focus on the CMLL World Welterweight Championship.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    },
    {
      "date": "2019-06-30",
      "kind": "reactivated",
      "text": "Kawato-San won a tournament final to win the vacant title.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    },
    {
      "date": "2019-11-06",
      "kind": "deactivated",
      "text": "CMLL vacated the title after Kawato-San was injured and unable to wrestle for four months.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    },
    {
      "date": "2022-03-15",
      "kind": "reactivated",
      "text": "Stigma won a tournament final against Suicida at Martes Populares to win the vacant title.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Lightweight_Championship"
      ]
    }
  ],
