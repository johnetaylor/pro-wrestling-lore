  "history": [
    {
      "date": "2018-04-09",
      "kind": "brand",
      "text": "Became exclusive to the 205 Live brand after that brand was established following WrestleMania 34.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Cruiserweight_Championship"
      ]
    },
    {
      "date": "2019-10-09",
      "kind": "brand",
      "text": "Renamed NXT Cruiserweight Championship when 205 Live merged into NXT; shared between NXT and 205 Live.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Cruiserweight_Championship"
      ]
    },
    {
      "date": "2020-01-25",
      "kind": "brand",
      "text": "Contendership extended to NXT UK after Jordan Devlin won the title at Worlds Collide.",
      "related": [
        "NXT UK"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Cruiserweight_Championship"
      ]
    },
    {
      "date": "2020-04-15",
      "kind": "interim",
      "text": "An interim title tournament was held in the U.S. during COVID-19 travel restrictions; Santos Escobar won it.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Cruiserweight_Championship"
      ]
    },
    {
      "date": "2021-04-08",
      "kind": "recognition",
      "text": "Santos Escobar beat Jordan Devlin in a ladder match to become the undisputed champion.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Cruiserweight_Championship"
      ]
    },
    {
      "date": "2022-01-04",
      "kind": "unified-into",
      "text": "Unified into the NXT North American Championship; Carmelo Hayes beat Roderick Strong to unify the titles.",
      "related": [
        "NXT North American Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Cruiserweight_Championship"
      ]
    },
    {
      "date": "2022-01-04",
      "kind": "retired",
      "text": "Title officially retired upon unification, with Carmelo Hayes recognized as the final champion.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Cruiserweight_Championship"
      ]
    }
  ],
