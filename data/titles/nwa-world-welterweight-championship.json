{
  "id": "nwa-world-welterweight-championship",
  "name": "NWA World Welterweight Championship",
  "promotion": "cmll",
  "division": "men",
  "format": "singles",
  "established": "1946-03-15",
  "retired": "2017-09-30",
  "names": [
    "World Welterweight Championship (original name, 1946–1952)",
    "NWA World Welterweight Championship (NWA prefix added when EMLL joined the National Wrestling Alliance)"
  ],
  "eras": [
    {
      "name": "World Welterweight Championship (original name, 1946–1952)",
      "from": "1946-03-15",
      "to": "1952"
    },
    {
      "name": "NWA World Welterweight Championship (NWA prefix added when EMLL joined the National Wrestling Alliance)",
      "from": "1952"
    }
  ],
  "history": [
    {
      "date": "1952",
      "kind": "recognition",
      "text": "EMLL joined the National Wrestling Alliance and the NWA prefix was added to the title.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    },
    {
      "date": "1992-06-19",
      "kind": "deactivated",
      "text": "Vacated when Misterioso left CMLL; CMLL's own welterweight title was created in February 1992, and no NWA champion was crowned for three years.",
      "related": [
        "CMLL World Welterweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    },
    {
      "date": "1995-12-01",
      "kind": "reactivated",
      "text": "CMLL brought the vacant title back when Negro Casas defeated El Hijo del Santo in a tournament final.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    },
    {
      "date": "1996-08-03",
      "kind": "unified-into",
      "text": "NJPW's tournament unified eight championships into the J-Crown; the title changed hands outside Mexico for the first time.",
      "related": [
        "J-Crown Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    },
    {
      "date": "1997-11-05",
      "kind": "split",
      "text": "Otani vacated six of the remaining J-Crown titles after being forced to return a belt to the WWF, ending the J-Crown and returning the titles to individual status.",
      "related": [
        "J-Crown Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    },
    {
      "date": "1999-02-06",
      "kind": "reactivated",
      "text": "Toryumon Japan became the promoter when Dragon Kid won the vacant title; Toryumon promoted it exclusively until 2007.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    },
    {
      "date": "2007-11-27",
      "kind": "promotion",
      "text": "La Sombra won the title from Hajime Ohara on a Toryumon Mexico show, returning control of the title to CMLL.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    },
    {
      "date": "2010-03",
      "kind": "recognition",
      "text": "NWA Mexico's Blue Demon Jr. demanded that CMLL stop promoting the NWA-branded titles; CMLL refused.",
      "related": [
        "NWA World Middleweight Championship",
        "NWA World Light Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    },
    {
      "date": "2010-08-12",
      "kind": "replaced-by",
      "text": "CMLL unveiled a new title to replace the original, conceding the original to NWA Mexico.",
      "related": [
        "NWA World Historic Welterweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    },
    {
      "date": "2017-09-30",
      "kind": "retired",
      "text": "The title was retired after Lightning One, Inc. bought the NWA and ended its licensee contracts.",
      "sources": [
        "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/NWA_World_Welterweight_Championship"
  ],
