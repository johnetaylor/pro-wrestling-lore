{
  "id": "mexican-national-trios-championship",
  "name": "Mexican National Trios Championship",
  "promotion": "cmll",
  "division": "men",
  "format": "trios",
  "established": "1985-03-10",
  "names": [],
  "eras": [
    {
      "name": "Mexican National Trios Championship",
      "from": "1985"
    }
  ],
  "history": [
    {
      "date": "1991",
      "kind": "brand",
      "text": "EMLL rebranded as CMLL, created the CMLL World Trios Championship, and kept rights to the Mexican National Trios Championship.",
      "related": [
        "CMLL World Trios Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "1992",
      "kind": "promotion",
      "text": "AAA was formed, and the reigning champions left CMLL for AAA, taking the title with them under commission approval.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "1993",
      "kind": "promotion",
      "text": "Los Infernales left EMLL for AAA, taking the trios championship with them after commission approval.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "1996",
      "kind": "promotion",
      "text": "AAA and PROMELL stopped working together, the title was vacated, and PROMELL was granted promotion rights and held a tournament.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "2001",
      "kind": "promotion",
      "text": "The Blue Panther team worked a few CMLL matches and lost the title to a CMLL team, returning control to CMLL.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "2003-06-20",
      "kind": "deactivated",
      "text": "After Nicho el Millonario no-showed a rematch, CMLL vacated the title and left it vacant for about five months.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "2003-11",
      "kind": "reactivated",
      "text": "CMLL held an eight-team tournament, won by El Felino, Safari and Volador Jr., to crown new champions.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "2009-12-19",
      "kind": "deactivated",
      "text": "The commission stripped Poder Mexica after Black Warrior left CMLL, and an eight-team tournament was announced to crown new champions.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "2010-01-06",
      "kind": "replaced-by",
      "text": "Máscara Dorada, Stuka Jr. and Metro defeated Poder Mexica to become the new champions.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "2010-11-18",
      "kind": "replaced-by",
      "text": "Máscara Dorada vacated his share of the title, and Delta was chosen as his replacement through a web poll.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "2011-01-09",
      "kind": "replaced-by",
      "text": "Rush, Diamante and Ángel de Oro won the title after the team lost the title in its first defense, following a CMLL tournament.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    },
    {
      "date": "2025-06-16",
      "kind": "replaced-by",
      "text": "Los Herederos defeated Los Viajeros Del Espacios at CMLL Lunes Clasico in Puebla to become the 46th overall champions.",
      "related": [
        "Los Viajeros Del Espacios"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/List_of_Mexican_National_Trios_Champions",
    "https://en.wikipedia.org/wiki/Mexican_National_Trios_Championship"
  ],
