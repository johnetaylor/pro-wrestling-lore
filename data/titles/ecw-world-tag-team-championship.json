  "history": [
    {
      "date": "1994-09",
      "kind": "promotion",
      "text": "Eastern Championship Wrestling left the NWA and became Extreme Championship Wrestling, and the title was established as a world tag team championship.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "2001-04-11",
      "kind": "retired",
      "text": "The title was retired when ECW closed in April 2001; Danny Doring and Roadkill were the final champions.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Tag_Team_Championship"
      ]
    },
    {
      "date": "2006",
      "kind": "brand",
      "text": "WWE relaunched ECW as a WWE brand, which ran until 2010, but the tag team championship was not reactivated.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Tag_Team_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/List_of_ECW_World_Tag_Team_Champions",
