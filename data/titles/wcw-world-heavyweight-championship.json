  "history": [
    {
      "date": "1991-01-11",
      "kind": "recognition",
      "text": "WCW claimed the NWA World Heavyweight Championship lineage for its new title.",
      "related": [
        "NWA World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1991-07-01",
      "kind": "deactivated",
      "text": "The title was vacated after Flair's WCW contract was terminated in a dispute with Jim Herd.",
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1991-07-14",
      "kind": "interim",
      "text": "A Dusty Rhodes belt with a gold plate stood in for the missing new belt until Lex Luger won the vacant title.",
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1992",
      "kind": "reactivated",
      "text": "The Big Gold Belt was used for the revived NWA title, a co-promotion between WCW and New Japan Pro-Wrestling.",
      "related": [
        "NWA World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1993-09",
      "kind": "promotion",
      "text": "WCW left the NWA, keeping the Big Gold Belt.",
      "related": [
        "NWA World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1993-09",
      "kind": "split",
      "text": "After leaving the NWA, the Big Gold Belt was renamed the WCW International World Heavyweight Championship, separate from the WCW title.",
      "related": [
        "WCW International World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1994-06",
      "kind": "unified-into",
      "text": "Flair beat Sting and unified the WCW and International titles, retiring the International title and keeping the Big Gold Belt.",
      "related": [
        "WCW International World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1994-06",
      "kind": "replaced-by",
      "text": "The mid-1991 to mid-1994 belt design was dropped in favor of the Big Gold Belt.",
      "related": [
        "WCW World Heavyweight Championship belt (mid-1991 to mid-1994 design)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2001-03",
      "kind": "promotion",
      "text": "The WWF bought WCW's assets, and the title became one of two world titles in the WWF.",
      "related": [
        "WWF Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2001-12-09",
      "kind": "unified-into",
      "text": "Chris Jericho beat The Rock and Stone Cold Steve Austin at Vengeance, unifying the World and WWF titles into the Undisputed WWF Championship.",
      "related": [
        "WWF Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2001-12-09",
      "kind": "retired",
      "text": "The title was retired upon unification with the WWF Championship at Vengeance.",
      "related": [
        "WWF Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WCW_World_Heavyweight_Championship"
      ]
    }
  ],
