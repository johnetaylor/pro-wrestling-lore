  "history": [
    {
      "date": "2002-09-02",
      "kind": "split",
      "text": "The Undisputed WWE Championship became SmackDown-exclusive, leaving Raw without a world title and reverting to the WWE Championship name.",
      "related": [
        "Undisputed WWE Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2002-09-02",
      "kind": "replaces",
      "text": "Presented as the successor to the WCW World Championship, though WWE states it is not a direct continuation.",
      "related": [
        "WCW World Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2005-06-30",
      "kind": "brand",
      "text": "Champion Batista was drafted to SmackDown in the 2005 WWE Draft Lottery.",
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2008-06-30",
      "kind": "brand",
      "text": "The title moved to Raw after CM Punk cashed in his Money in the Bank contract to defeat Edge.",
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2009-02-15",
      "kind": "brand",
      "text": "The title moved to SmackDown after Edge won it in an Elimination Chamber match at No Way Out.",
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2009-04-05",
      "kind": "brand",
      "text": "The title moved to Raw after John Cena beat Edge and Big Show at WrestleMania 25.",
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2009-04-26",
      "kind": "brand",
      "text": "The title moved back to SmackDown after Edge beat Cena in a Last Man Standing match at Backlash.",
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2009-12",
      "kind": "recognition",
      "text": "A DVD set on the title's history definitively linked it to the WCW and NWA titles.",
      "related": [
        "WCW World Championship",
        "NWA World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2011-08-29",
      "kind": "brand",
      "text": "The brand extension ended, and the title could appear on both Raw and SmackDown.",
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2013-12-15",
      "kind": "unified-into",
      "text": "Randy Orton beat John Cena in a TLC match to unify the titles, and the combined title was renamed WWE World Heavyweight Championship.",
      "related": [
        "WWE Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2013-12-15",
      "kind": "retired",
      "text": "The World Heavyweight Championship was retired upon unification with the WWE Championship.",
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    },
    {
      "date": "2023-04-24",
      "kind": "replaced-by",
      "text": "Triple H unveiled a new World Heavyweight Championship, which does not carry this title's lineage but is considered its direct successor.",
      "related": [
        "World Heavyweight Championship (2023)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/World_Heavyweight_Championship_(WWE,_2002%E2%80%932013)"
      ]
    }
  ],
