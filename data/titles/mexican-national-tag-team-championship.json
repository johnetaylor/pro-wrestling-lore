{
  "id": "mexican-national-tag-team-championship",
  "name": "Mexican National Tag Team Championship",
  "promotion": "cmll",
  "division": "men",
  "format": "tag",
  "established": "1957-06-14",
  "names": [],
  "history": [
    {
      "date": "1957-06-14",
      "kind": "recognition",
      "text": "Some publications said the early belts were another title, and some pre-1982 reigns may belong to other championships.",
      "related": [
        "CMLL Arena Coliseo Tag Team Championship",
        "EMLL Arena México Tag Team Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
      ]
    },
    {
      "date": "1992",
      "kind": "promotion",
      "text": "Los Destructores left CMLL and took the title to AAA, which defended it until 2007.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
      ]
    },
    {
      "date": "1995-12",
      "kind": "recognition",
      "text": "AAA declared the title vacant after Fuerza Guerrera left the promotion.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
      ]
    },
    {
      "date": "1996-01-12",
      "kind": "recognition",
      "text": "The Juventud Guerrera and Psicosis win was not recognized; the commission held that Los Guerreras never lost the titles and returned the belts in August 1996.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
      ]
    },
    {
      "date": "1997-07-20",
      "kind": "promotion",
      "text": "Top Win Promotions held a tournament to fill the title after AAA vacated it.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
      ]
    },
    {
      "date": "2003",
      "kind": "recognition",
      "text": "The title became recognized on the Mexican independent circuit at some point during Octagón and La Parka's reign.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
      ]
    },
    {
      "date": "2009",
      "kind": "promotion",
      "text": "AAA stopped promoting all Mexican National Championships in early 2009, and the title was defended on independent shows in 2009 and 2011.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
      ]
    },
    {
      "date": "2011-12-25",
      "kind": "deactivated",
      "text": "Last known defense (no earlier than this date); the title was inactive afterward.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
      ]
    },
    {
      "date": "2020-02-19",
      "kind": "reactivated",
      "text": "CMLL announced it was bringing the title back, and a tournament won by Atlantis Jr. and Flyer on March 13, 2020 followed.",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/Mexican_National_Tag_Team_Championship"
