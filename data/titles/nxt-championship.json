    {
      "date": "2017",
      "kind": "recognition",
      "text": "Drew McIntyre's win was described in the official title history as a world championship.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Championship"
      ]
    },
    {
      "date": "2019-09",
      "kind": "brand",
      "text": "NXT became WWE's third brand when the NXT program moved to the USA Network.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Championship"
      ]
    },
    {
      "date": "2021",
      "kind": "recognition",
      "text": "Revealed as an option for the men's Royal Rumble winner to challenge for at WrestleMania 37, alongside the WWE and Universal titles.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Championship"
      ]
    },
    {
      "date": "2021-09",
      "kind": "recognition",
      "text": "Dropped the world championship designation when NXT returned to its original role as a developmental brand.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Championship"
      ]
    },
    {
      "date": "2022-09-04",
      "kind": "unified-into",
      "text": "Bron Breakker beat Tyler Bate at Worlds Collide, unifying the NXT UK Championship into the NXT Championship.",
      "related": [
        "NXT United Kingdom Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Championship"
      ]
    },
    {
      "date": "2024-10-01",
      "kind": "brand",
      "text": "NXT moved to The CW, and the championship belt was updated to match the new show logo.",
      "sources": [
        "https://en.wikipedia.org/wiki/NXT_Championship"
      ]
    }
  ],
