  "history": [
    {
      "date": "2013-01-15",
      "kind": "deactivated",
      "text": "Rush relinquished the title to pursue the heavyweight title in a storyline feud with El Terrible, leaving it vacant.",
      "related": [
        "CMLL World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "2013-01-29",
      "kind": "reactivated",
      "text": "Rey Escorpión won the vacant title by defeating Volador Jr. in the tournament final.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "1996-07-19",
      "kind": "recognition",
      "text": "CMLL did not approve Aquarius's title win over Dr. Wagner Jr. in Japan, so it is not officially recognized; Wagner regained the title on 1996-07-27.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "2017-05-22",
      "kind": "deactivated",
      "text": "CMLL fired La Máscara and vacated the title.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Light_Heavyweight_Championship"
      ]
    },
    {
      "date": "2017-06-10",
      "kind": "reactivated",
      "text": "Niebla Roja won the vacant title in a 10-man torneo cibernetico.",
      "sources": [
        "https://en.wikipedia.org/wiki/CMLL_World_Light_Heavyweight_Championship"
      ]
    }
  ],
