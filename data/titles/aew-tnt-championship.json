  "history": [
    {
      "date": "2020-12-30",
      "kind": "retired",
      "text": "The red-strap belt design was retired in honor of Mr. Brodie Lee, though the article says the championship itself was not retired.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_TNT_Championship"
      ]
    },
    {
      "date": "2020-12-30",
      "kind": "recognition",
      "text": "Brodie Lee Jr. was honored as \"TNT Champion for life\" by Tony Khan.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_TNT_Championship"
      ]
    },
    {
      "date": "2021-01-06",
      "kind": "replaced-by",
      "text": "Darby Allin unveiled a new black-strap version of the belt, replacing the retired red-strap design.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_TNT_Championship"
      ]
    },
    {
      "date": "2022-01-08",
      "kind": "interim",
      "text": "Sammy Guevara beat Dustin Rhodes to become interim champion after Cody Rhodes withdrew from the scheduled title match due to a COVID-19 quarantine.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_TNT_Championship"
      ]
    },
    {
      "date": "2022-01-26",
      "kind": "interim",
      "text": "Guevara beat Cody Rhodes in a ladder match to become the undisputed champion, ending the interim status.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_TNT_Championship"
      ]
    },
    {
      "date": "2022-01",
      "kind": "brand",
      "text": "Dynamite moved to TBS while Rampage stayed on TNT; the title was defended on quarterly TNT Battle of the Belts specials.",
      "sources": [
        "https://en.wikipedia.org/wiki/AEW_TNT_Championship"
      ]
    }
  ],
  "sources": [
    "https://en.wikipedia.org/wiki/List_of_AEW_TNT_Champions",
