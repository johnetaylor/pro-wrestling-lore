  "established": "1926",
  "names": [],
  "history": [
    {
      "date": "1934-06-21",
      "kind": "promotion",
      "text": "EMLL (later CMLL) was given full promotional control, with the Commission only approving champions",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "1996-09-20",
      "kind": "promotion",
      "text": "AAA took over booking of the title after Máscara Sagrada won it; the Commission officially recognized AAA's control",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "2006-09-13",
      "kind": "replaced-by",
      "text": "AAA created the AAA Mega Championship, and the National title was no longer promoted",
      "related": [
        "AAA Mega Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "2007-09-16",
      "kind": "retired",
      "text": "Infobox lists retirement on this date; the article body does not give a matching date",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "2009",
      "kind": "reactivated",
      "text": "Champion Charly Manson defended the title on the Mexican independent circuit; the title was active again until 2013",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "2013-05-26",
      "kind": "deactivated",
      "text": "Title deactivated after champion Héctor Garza died; the text gives May 23, 2013 as the death date, while the table gives May 26",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Heavyweight_Championship"
      ]
    },
    {
      "date": "2017-10",
      "kind": "reactivated",
      "text": "CMLL announced it was bringing the championship back under its control",
      "sources": [
        "https://en.wikipedia.org/wiki/Mexican_National_Heavyweight_Championship"
      ]
    }
