  "history": [
    {
      "date": "2008-06-06",
      "kind": "replaces",
      "text": "Created as SmackDown's alternative to Raw's Women's Championship, which was exclusive to Raw.",
      "related": [
        "WWE Women's Championship (original version)"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Divas_Championship"
      ]
    },
    {
      "date": "2009-04-13",
      "kind": "brand",
      "text": "Champion Maryse was drafted to Raw in the 2009 WWE draft, making the title exclusive to Raw.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Divas_Championship"
      ]
    },
    {
      "date": "2010-01-04",
      "kind": "deactivated",
      "text": "Title was vacated after champion Melina tore her anterior cruciate ligament.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Divas_Championship"
      ]
    },
    {
      "date": "2010-02-22",
      "kind": "reactivated",
      "text": "Maryse won the vacant title from Gail Kim on Raw, ending the vacancy.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Divas_Championship"
      ]
    },
    {
      "date": "2010-09-19",
      "kind": "unified-into",
      "text": "Michelle McCool beat Melina at Night of Champions to unify the Divas and Women's titles; the Women's Championship was retired.",
      "related": [
        "WWE Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Divas_Championship"
      ]
    },
    {
      "date": "2011-08-29",
      "kind": "brand",
      "text": "The first brand extension ended, and the title became accessible to both brands permanently.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Divas_Championship"
      ]
    },
    {
      "date": "2016-04-03",
      "kind": "replaced-by",
      "text": "At WrestleMania 32, a new Women's Championship replaced the Divas Championship.",
      "related": [
        "WWE Women's Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Divas_Championship"
      ]
    },
    {
      "date": "2016-04-03",
      "kind": "retired",
      "text": "The Divas Championship was retired at WrestleMania 32, with Charlotte as the final champion.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWE_Divas_Championship"
      ]
    }
  ],
