      ]
    },
    {
      "date": "1984-07-05",
      "kind": "recognition",
      "text": "The WWF regained recognition of Fujinami's title, though NJPW treated his second reign as uninterrupted.",
      "sources": [
        "https://en.wikipedia.org/wiki/WWF_International_Heavyweight_Championship"
      ]
    },
    {
      "date": "1985-10-31",
      "kind": "deactivated",
      "text": "The championship was abandoned when the WWF ended its working relationship with NJPW.",
