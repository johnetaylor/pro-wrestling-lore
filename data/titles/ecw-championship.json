  "history": [
    {
      "date": "1994-08-27",
      "kind": "split",
      "text": "Shane Douglas won the NWA title, relinquished it, and proclaimed himself ECW World Heavyweight Champion, with ECW leaving the NWA.",
      "related": [
        "NWA World Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1994-08-27",
      "kind": "recognition",
      "text": "WWE considers Shane Douglas, not Jimmy Snuka, the inaugural world heavyweight champion, dating from this reign.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "1999-03-21",
      "kind": "unified-into",
      "text": "Taz defeated Sabu at ECW Living Dangerously, effectively unifying the FTW Heavyweight Championship with the ECW title.",
      "related": [
        "FTW Heavyweight Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2000-04-13",
      "kind": "interim",
      "text": "Taz, on a one-night WWF loan, beat Mike Awesome to reclaim the title for ECW after Awesome signed with WCW.",
      "related": [
        "WCW",
        "WWF"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2001-04-11",
      "kind": "deactivated",
      "text": "The title was deactivated when ECW ceased all operations.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2003-01-28",
      "kind": "promotion",
      "text": "WWE purchased ECW's assets, having renamed the WWF to WWE in 2002.",
      "related": [
        "WWE"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2006-06-13",
      "kind": "reactivated",
      "text": "The title was revived as the ECW brand's world title and awarded to Rob Van Dam, who had won the WWE Championship at One Night Stand.",
      "related": [
        "WWE Championship"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2007-06-11",
      "kind": "interim",
      "text": "After Bobby Lashley vacated the title in the draft, a tournament was held to crown a new champion, won by Johnny Nitro at Vengeance: Night of Champions.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2008-01-22",
      "kind": "brand",
      "text": "The title moved to the SmackDown brand when Chavo Guerrero won it from CM Punk.",
      "related": [
        "SmackDown"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2008-06-23",
      "kind": "brand",
      "text": "The title was drafted to Raw as its sole world title, after Kane was drafted there.",
      "related": [
        "Raw"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2008-06-29",
      "kind": "brand",
      "text": "The title returned to ECW when Mark Henry beat Kane and Big Show in a triple threat match at Night of Champions.",
      "related": [
        "ECW"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    },
    {
      "date": "2010-02-16",
      "kind": "retired",
      "text": "The title was retired after the final ECW episode, when Ezekiel Jackson beat Christian to become the final champion.",
      "sources": [
        "https://en.wikipedia.org/wiki/ECW_World_Heavyweight_Championship"
      ]
    }
  ],
