{
  "id": "anoai",
  "name": "Anoaʻi · Maivia · Fifita",
  "description": "Connected branches of the extended wrestling family. Biological descent, adoption and honorary bonds are shown separately; membership in The Bloodline does not itself establish kinship.",
  "branches": [
    {
      "id": "anoai",
      "name": "Anoaʻi and Fatu",
      "note": "Generations descend from top to bottom. Scroll sideways to follow the wider branches."
    },
    {
      "id": "maivia",
      "name": "Maivia and Johnson",
      "note": "The Anoaʻi connection runs through Amituanaʻi and Peter’s blood-brother bond, not a shared biological ancestor."
    },
    {
      "id": "fifita",
      "name": "Fifita · Haku’s family",
      "note": "The Rock calls Haku his uncle as an honorary family relationship. Tama Tonga and Talla Tonga were adopted by Haku and his wife; Tonga Loa is Haku’s biological son."
    },
    {
      "id": "fanene",
      "name": "Fanene",
      "note": "Nia Jax connects through Peter Maivia’s cousin Joseph Fanene."
    }
  ],
